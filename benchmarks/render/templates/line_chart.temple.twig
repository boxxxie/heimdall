<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ this.width | int }} {{ this.height | int }}" width="{{ this.width | int }}" height="{{ this.height | int }}" role="img" aria-label="{{ this.title }}">
<style>
  .bg { fill: #0d1117; }
  .panel { fill: #161b22; stroke: #30363d; stroke-width: 1; }
  .grid { stroke: #21262d; stroke-width: 1; }
  .axis { stroke: #30363d; stroke-width: 1.2; }
  .title { fill: #f0f6fc; font: 700 16px -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  .sub { fill: #8b949e; font: 400 12px -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  .tick { fill: #8b949e; font: 500 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .legend { fill: #c9d1d9; font: 500 11.5px -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  .val { font: 600 10.5px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
</style>
<rect class="bg" width="{{ this.width | int }}" height="{{ this.height | int }}" rx="10"/>
<rect class="panel" x="{{ this.pad_l | int }}" y="{{ this.pad_t | int }}" width="{{ this.pw | int }}" height="{{ this.ph | int }}" rx="4"/>
<text class="title" x="{{ this.pad_l | int }}" y="30">{{ this.title }}</text>
<text class="sub" x="{{ this.pad_l | int }}" y="49">{{ this.subtitle }} · {{ this.y_unit_label }}</text>
{%- for yt in this.y_ticks %}
<line class="grid" x1="{{ this.pad_l | int }}" y1="{{ yt.pos }}" x2="{{ this.plot_right | int }}" y2="{{ yt.pos }}"/>
<text class="tick" x="{{ this.y_label_x | int }}" y="{{ yt.text_pos }}" text-anchor="end">{{ yt.label }}</text>
{%- end %}
{%- for xt in this.x_ticks %}
<line class="grid" x1="{{ xt.pos }}" y1="{{ this.pad_t | int }}" x2="{{ xt.pos }}" y2="{{ this.plot_bottom | int }}"/>
<text class="tick" x="{{ xt.pos }}" y="{{ this.x_label_y | int }}" text-anchor="middle">{{ xt.label }}</text>
{%- end %}
<line class="axis" x1="{{ this.pad_l | int }}" y1="{{ this.plot_bottom | int }}" x2="{{ this.plot_right | int }}" y2="{{ this.plot_bottom | int }}"/>
<line class="axis" x1="{{ this.pad_l | int }}" y1="{{ this.pad_t | int }}" x2="{{ this.pad_l | int }}" y2="{{ this.plot_bottom | int }}"/>
{%- for s in this.series %}
{%- if s.has_path %}
<path d="{{ s.path_d }}" fill="none" stroke="{{ s.color }}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
{%- end %}
{%- for pt in s.points %}
<circle cx="{{ pt.x }}" cy="{{ pt.y }}" r="4" fill="{{ s.color }}" stroke="#0d1117" stroke-width="1.5"/>
{%- end %}
{%- end %}
{%- for el in this.end_labels %}
<text class="val" x="{{ this.end_label_x | int }}" y="{{ el.y }}" text-anchor="start" fill="{{ el.color }}">{{ el.text }}</text>
{%- end %}
{%- for lg in this.legend %}
<rect x="{{ lg.x }}" y="{{ lg.rect_y }}" width="12" height="4" rx="2" fill="{{ lg.color }}"/>
<text class="legend" x="{{ lg.text_x }}" y="{{ lg.text_y }}">{{ lg.label }}</text>
{%- end %}
</svg>
