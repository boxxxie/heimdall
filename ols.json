{
	"$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
	"collections": [
		{ "name": "heimdall", "path": "./heimdall" },
		{ "name": "odinarrow", "path": "./deps/OdinArrow/src" },
		{ "name": "actor", "path": "./deps/sleipnir/actor" }
	],
	"enable_document_symbols": true,
	"enable_hover": true,
	"enable_snippets": true,
	"enable_semantic_tokens": true,
	"enable_inlay_hints": true,
	"enable_checker_only_saved": true,
	"checker_args": "-vet -strict-style -vet-tabs -disallow-do -vet-packages:heimdall,heimdall_codegen,heimdall_tests,heimdall_benchmarks"
}
